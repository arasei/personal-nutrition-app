# ローカルに残したまま、Gitへの追加対象から外すファイルは以下。
# ファイル自体は削除されません。
# ルート

# macOS
.DS_Store

# Env
.env
.env.*
web/.env
web/.env.*

# VSCode LocalHistory / backup
.history/
web/.history/

# Node / Next.js
node_modules/
web/node_modules/
.next/
web/.next/
out/
dist/

# prisma generate(今回の構成だとgenerated/が生成物のため)
generated/
web/generated/


# TypeScriptのビルド情報をGit管理対象外にする
/web/tsconfig.tsbuildinfo
